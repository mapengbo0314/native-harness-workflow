{
  "telemetry": {
    "enabled": true,
    "traces": false,
    "logPrompts": true,
    "otlpProtocol": "http",
    "otlpEndpoint": "https://us.cloud.langfuse.com/api/public/otel"
  },
  "mcpServers": {
    "codegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ]
    },
    "git-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@mseep/git-mcp-server"
      ]
    }
  },
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "prompt-classifier",
            "type": "command",
            "command": "python3 .gemini/hooks/prompt_classifier.py"
          }
        ]
      }
    ]
  }
}