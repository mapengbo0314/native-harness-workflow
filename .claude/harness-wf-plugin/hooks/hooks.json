{
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "continuous-learning-session-end",
            "type": "command",
            "command": "python3 \"${HARNESS_PLUGIN_ROOT}/hooks/session_end.py\"",
            "description": "Continuous Learning: triggers skill extraction on session end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${HARNESS_PLUGIN_ROOT}/hooks/prompt_classifier.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "compression-notifier",
            "type": "command",
            "command": "python3 \"${HARNESS_PLUGIN_ROOT}/hooks/notify_compression.py\"",
            "description": "Alerts the user that context is being compressed so they can run /clear"
          },
          {
            "name": "session-memory-save-precompact",
            "type": "command",
            "command": "python3 \"${HARNESS_PLUGIN_ROOT}/hooks/session_memory_save.py\"",
            "description": "Heartbeat: persists session memory state before context compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "sequential": true,
        "hooks": [
          {
            "name": "pre-tool-use-security",
            "type": "command",
            "command": "python3 \"${HARNESS_PLUGIN_ROOT}/hooks/pre_tool_use.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "sequential": true,
        "hooks": [
          {
            "name": "post-tool-use-linting",
            "type": "command",
            "command": "python3 \"${HARNESS_PLUGIN_ROOT}/hooks/post_tool_use.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "session-memory-save-stop",
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_memory_save.py\"",
            "description": "Heartbeat: persists session memory state after each assistant response"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "session-memory-inject",
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\"",
            "description": "Injects a digest of prior session memory entries as additional context"
          }
        ]
      }
    ]
  }
}
