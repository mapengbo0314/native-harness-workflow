          },
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "json_path": {
            "type": "string"
          },
          "expected_value": {},
          "command": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "integer"
          },
          "expected_exit_code": {
            "type": "integer"
          },
          "max_output_chars": {
            "type": "integer"
          }
        },
        "required": [
          "type"
        ]
      }
    }
  },
  "required": [
