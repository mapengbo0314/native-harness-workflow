      "type": "integer"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "file_exists",
              "does_not_exist",
              "contains",
              "not_contains",
              "regex",
              "json_path_equals",
              "command"
