{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"${HARNESS_PLUGIN_ROOT}/hooks/prompt_classifier.py\""
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "filters": [],
        "hooks": [
          {"command": "${HARNESS_PLUGIN_ROOT}/hooks/doc-manifest-validator.sh"},
          {"command": "python3 ${HARNESS_PLUGIN_ROOT}/scripts/sync_manifest_state.py"}
        ]
      }
    ]
  }
}
