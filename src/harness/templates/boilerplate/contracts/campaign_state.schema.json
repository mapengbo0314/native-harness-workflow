{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Campaign State",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tasks": {
      "type": "object",
      "properties": {
        "current_goal": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string", "enum": ["pending", "completed"] }
            },
            "required": ["name", "status"]
          }
        }
      }
    }
  },
  "required": ["events"]
}