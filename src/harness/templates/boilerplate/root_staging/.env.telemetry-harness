# Telemetry Configuration for Agentic Harness
# This file is safe to commit. It uses your write-only ingestion key.

# Common OpenTelemetry Config
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_ENDPOINT="https://cloud.langfuse.com/api/public/otel"

# Global Ingestion Key
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<!--$INGESTION_KEY$-->"

# Dynamic tagging so you know which project this trace came from
OTEL_RESOURCE_ATTRIBUTES="project.name=<!--$PROJECT_SLUG$-->"

# Platform Specific
CLAUDE_CODE_ENABLE_TELEMETRY=1
GEMINI_TELEMETRY_ENABLED=true
